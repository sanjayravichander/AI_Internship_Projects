# ========================================
# AI INTERNSHIP PROJECTS - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and add your actual API keys

# ========================================
# REQUIRED API KEYS
# ========================================

# Groq API Key (Required for most AI features)
# Get your free API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ========================================
# OPTIONAL API KEYS
# ========================================

# HuggingFace API Key (Optional - for advanced embeddings)
# Get your free API key from: https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=your_hf_api_key_here

# OpenAI API Key (Optional - for alternative LLM support)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
# For Voice Assistant email functionality

# Gmail address for sending emails
EMAIL_ADDRESS=your_email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_16_character_app_password

# ========================================
# WEATHER API (Optional)
# ========================================
# For Voice Assistant weather functionality

# OpenWeatherMap API Key
# Get your free API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here

# ========================================
# APPLICATION SETTINGS
# ========================================

# Default language for applications
DEFAULT_LANGUAGE=en

# Default timezone
DEFAULT_TIMEZONE=UTC

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=100

# Enable debug mode (true/false)
DEBUG_MODE=false

# ========================================
# ADVANCED SETTINGS
# ========================================

# Model configurations
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1000

# Vector database settings
VECTOR_DB_TYPE=faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cache settings
ENABLE_CACHE=true
CACHE_TTL=3600

# ========================================
# SETUP INSTRUCTIONS
# ========================================
# 1. Copy this file to .env (remove .example extension)
# 2. Replace all 'your_*_here' values with actual API keys
# 3. At minimum, you need the GROQ_API_KEY for basic functionality
# 4. Save the file and run: streamlit run app.py
# 
# IMPORTANT NOTES:
# - Never commit the .env file to version control
# - Keep your API keys secure and private
# - Some features may not work without their respective API keys
# - Gmail requires an "App Password", not your regular password
# ========================================